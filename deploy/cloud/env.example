# Copy to .env on the server (chmod 600) and fill in. Secrets live only in .env, never in the image or the repository.
# These are the public demo's settings, the ones deploy/supervise.ps1 gives the workstation's public API (deploy/README.md,
# the public demo); a value that differs from the workstation's says why.

# --- Access: anyone may enter, each browser in a workspace of its own. The gate stays required: sessions are signed with
# the secret, and with REQUIRED set a missing or short secret stops the API from starting instead of opening it
# (api/access.check_configuration). At least 32 characters; make it on the server with
#   python3 -c 'import secrets; print("WORKBENCH_ACCESS_SECRET=" + secrets.token_urlsafe(48))' >> .env
# and delete the empty line below, so the secret is never typed, pasted or shown. Keep a copy where you keep passwords:
# a new secret ends every session, and the workspaces they held are deleted when their seven days end.
WORKBENCH_ACCESS_REQUIRED=1
WORKBENCH_ACCESS_SECRET=
WORKBENCH_ANONYMOUS_SESSIONS=1
# The seven days the first screen promises are the default; WORKBENCH_ANONYMOUS_RETENTION_DAYS is deliberately not set.

# --- The release to run: the short commit the images were built from and carry (verity-api:<tag>, verity-web:<tag>).
# Compose refuses to start while it is empty. Set it once the images are on this host (README.md, HETZNER.md):
#   sed -i '/^VERITY_TAG=/d' .env && echo VERITY_TAG=<short sha> >> .env
VERITY_TAG=

# --- The store this host serves, by its role: a Docker volume name. Staging and production never share one; a host that
# changes role gets a new store, and the old one stays until it is deliberately removed (HETZNER.md, Stores). The
# staging host of 2026-10-13 keeps the volume it already has: verity_verity-data.
VERITY_STORE=

# --- Where this file, tunnel.json and contract-state.json live: outside every release directory (HETZNER.md,
# Releases). Empty: beside compose.yml, as on a single checkout.
VERITY_SHARED=

# --- The edge (compose.yml): `caddy` on a host with its own public address (Caddy terminates TLS), `tunnel` on a host
# with no inbound port (a Cloudflare Tunnel connector, as on the workstation; HETZNER.md). Read by compose from this file.
COMPOSE_PROFILES=tunnel
# With `tunnel`: the tunnel's id (`cloudflared tunnel list`). Its credentials are tunnel.json beside compose.yml, never
# here. One tunnel per host: a second host's connector on the same tunnel would put a second store behind the name.
VERITY_TUNNEL_ID=

# --- Origin: the one address the interface and the API share (the edge serves both). Sessions and every write are
# refused from any other origin. VERITY_SITE is the same name without https:// (Caddy's site; unused with `tunnel`).
VERITY_SITE=verity.example.com
WORKBENCH_APP_URL=https://verity.example.com
WORKBENCH_CORS_ORIGINS=https://verity.example.com

# --- The readers' new questions per UTC day, all together, as on the workstation. The model runs on this host for a
# monthly price, so a question costs time, not money; the bound keeps one busy day from queueing every reader behind it.
# One browser's share is the default, 30 a day.
WORKBENCH_MAX_RUNS_PER_DAY=200

# --- Answering, pinned as on the workstation.
WORKBENCH_PROVIDER=ollama
WORKBENCH_MODEL=qwen3:8b
WORKBENCH_RETRIEVAL=bm25
WORKBENCH_RETRIEVAL_K=6
WORKBENCH_PROMPT_VERSION=answer-v2

# --- Model: Ollama on this host (compose.yml, service `ollama`), reached on the compose network only. The reference build
# is qwen3:8b, Ollama digest 500a1f067a9f (Q4_K_M), the workstation's.
WORKBENCH_OLLAMA_URL=http://ollama:11434
# Set, every answer is preceded by a check that Ollama serves this build; any other build fails the run.
WORKBENCH_MODEL_DIGEST=500a1f067a9f
WORKBENCH_MODEL_CONCURRENCY=1
# Health asks the model, as the workstation's does: it costs nothing here. The model stays loaded (OLLAMA_KEEP_ALIVE in
# compose.yml), so nothing is woken; WORKBENCH_MODEL_WAKEUP and WORKBENCH_MODEL_HOST stay unset (the model is on this
# server, and the interface says so).
WORKBENCH_HEALTH_PROBES_MODEL=1

# --- Set by compose.yml, not here: WORKBENCH_DATA_DIR=/data, WORKBENCH_CONTRACT_STATE (the record /state shows).
