# Copy to .env on the server (chmod 600) and fill in. Secrets live only in .env, never in the image or the repository.

# --- Access: the live workbench is invite-only. With REQUIRED set, a missing or short secret stops the API from
# starting instead of opening it (api/access.check_configuration). At least 32 characters; make it on the server with
#   python3 -c 'import secrets; print("WORKBENCH_ACCESS_SECRET=" + secrets.token_urlsafe(48))' >> .env
# and delete the empty line below, so the secret is never typed, pasted or shown.
WORKBENCH_ACCESS_REQUIRED=1
WORKBENCH_ACCESS_SECRET=
# Invite subjects to shut out at once, comma separated (scripts/access.py revoke).
WORKBENCH_ACCESS_REVOKED=

# --- Origin: the one address the interface and the API share (Caddy serves both).
WORKBENCH_APP_URL=https://try.example.com
WORKBENCH_CORS_ORIGINS=https://try.example.com

# --- Model: Ollama-compatible endpoint. The reference build is qwen3:8b, Ollama digest 500a1f067a9f (Q4_K_M).
WORKBENCH_PROVIDER=ollama
WORKBENCH_MODEL=qwen3:8b
WORKBENCH_OLLAMA_URL=https://your-endpoint.example
# Headers the endpoint's proxy needs, as JSON, e.g. {"Modal-Key": "...", "Modal-Secret": "..."}. Never logged.
WORKBENCH_OLLAMA_HEADERS=
# Set, every answer is preceded by a check that the endpoint serves this build; any other build fails the run.
WORKBENCH_MODEL_DIGEST=500a1f067a9f
# A cold GPU loads the model before the first answer; the run timeout covers it.
WORKBENCH_MODEL_CONCURRENCY=1
# Said wherever the interface tells a reader where a contract's text goes (the owner's wording).
WORKBENCH_MODEL_HOST=
# Health does not ask a model that bills by the second and starts cold; each answer still checks the pinned build first.
WORKBENCH_HEALTH_PROBES_MODEL=0
# The readers' new questions per UTC day, all together; past it a question waits for midnight (the owner sets the number).
WORKBENCH_MAX_RUNS_PER_DAY=

# --- /state is published as the static artifact (backend/scripts/export_state.py); the live workbench does not need
# the lab's record. Leave unset.
# WORKBENCH_CONTRACT_STATE=
