# Certificates come from Let's Encrypt. On the first bring-up set VERITY_ACME_CA to the staging directory
# (https://acme-staging-v02.api.letsencrypt.org/directory) until the name resolves and ports 80/443 answer: failed
# attempts against production count toward its rate limits and can lock the name out for hours.
{
	acme_ca {$VERITY_ACME_CA}
	# HTTP/1.1 and HTTP/2 only: the firewall opens TCP 443, not the UDP HTTP/3 would need, so it is not advertised.
	servers {
		protocols h1 h2
	}
}

# One origin for the workbench: TLS here, /api to the API, everything else to the interface. Same origin means no CORS,
# and the session cookie (__Host-, Secure, SameSite=Strict) stays first-party.
{$VERITY_SITE} {
	{$VERITY_TLS}

	handle /api/* {
		# The API refuses a file over 25 MB, but only after the body has arrived; a larger body is refused here instead,
		# before it is received (application/ingest_document.py MAX_UPLOAD_BYTES, plus the form's own bytes).
		request_body {
			max_size 26MiB
		}
		reverse_proxy api:8000 {
			# The API keys its request limits by Cf-Connecting-Ip (api/access.client_address). There is no Cloudflare in
			# front of this server, so a client could send its own and choose its bucket: it is set here, from the address
			# Caddy actually saw, and whatever the client sent is replaced.
			header_up Cf-Connecting-Ip {remote_host}
			# Run events are a stream; send each one as it is written.
			flush_interval -1
		}
	}

	handle {
		reverse_proxy web:3000 {
			header_down -X-Powered-By
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# No page is meant to be framed. Set only where the response has no policy of its own (the memo has).
		?Content-Security-Policy "frame-ancestors 'none'"
		-Server
		defer
	}
}
